# Bubble Environment Variables

# Basic Configuration
PORT=3000
SESSION_SECRET=your-super-secret-session-key

# Notion Configuration (Existing - for waitlist)
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID_WAITLIST=your-waitlist-database-id

# OpenRouter AI Configuration (Existing - for chatbot)
OPENROUTER_API_KEY=your-openrouter-api-key

# Blog Configuration (for Notion-powered blog)
# Create a separate Notion integration for blog management
# The database should have these properties:
# - Title (title)
# - Slug (rich_text) 
# - Summary (rich_text)
# - Status (select: Published, Draft, Scheduled)
# - Published Date (date)
# - Featured Image (files)
NOTION_BLOG_API_KEY=your-notion-blog-integration-token
NOTION_BLOG_DATABASE_ID=your-blog-database-id