# Bubble Environment Variables

# Basic Configuration
PORT=3000
NODE_ENV=development

# Session Security (REQUIRED - app will not start without this)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Notion Configuration (Existing - for waitlist)
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID_WAITLIST=your-waitlist-database-id
NOTION_DATABASE_ID_BUSINESS=your-business-database-id

# OpenRouter AI Configuration (Existing - for chatbot)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI Configuration (for image generation)
OPENAI_API_KEY=your-openai-api-key

# Blog Configuration (for Notion-powered blog)
# Create a separate Notion integration for blog management
# The database should have these properties:
# - Title (title)
# - Slug (rich_text)
# - Summary (rich_text)
# - Status (select: Published, Draft, Scheduled)
# - Published Date (date)
# - Featured Image (files)
NOTION_BLOG_API_KEY=your-notion-blog-integration-token
NOTION_BLOG_DATABASE_ID=your-blog-database-id

# Knowledge Garden Configuration
# Database ID for the knowledge garden/references database
NOTION_KNOWLEDGE_GARDEN_DATABASE_ID=1ffcfc520644805b8bb9c9207fb2cb31

# Newsletter Configuration
# Database should have: Name (title), Email (email), Profession (select), Role (select), Subscribed At (date)
# Roles are auto-determined: tech, finance, balanced
NOTION_DATABASE_ID_NEWSLETTER=your-newsletter-database-id