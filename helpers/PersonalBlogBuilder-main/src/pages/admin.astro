---
import Layout from '../layouts/Layout.astro';
import ChatInterface from '../components/ChatInterface.astro';
import { authMiddleware } from '../middleware/auth';

// Protect this route with authentication
const authResponse = await authMiddleware(Astro);
if (authResponse) return authResponse;
---

<Layout title="AI Blog Builder - Admin">
	<main class="min-h-screen flex flex-col">
		<div class="p-4 bg-blue-50 border-l-4 border-blue-500 flex justify-between items-center">
			<p class="text-blue-700">
				<strong>Admin Area:</strong> This is your private writing tool for creating blog posts.
			</p>
			<div class="flex space-x-4">
				<a href="/blog" class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors text-sm">
					View Blog
				</a>
				<a href="/logout" class="px-3 py-1 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors text-sm">
					Logout
				</a>
			</div>
		</div>
		<div class="flex-grow p-4">
			<ChatInterface />
		</div>
	</main>
</Layout>
